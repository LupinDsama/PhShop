# ============================================================
# PhShop — cấu hình môi trường
# Copy file này thành .env (hoặc set trực tiếp trong hạ tầng) và ĐỔI các giá trị
# dưới đây. KHÔNG commit file .env thật — .gitignore đã loại trừ.
# ============================================================

# --- Server ---
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# Database: đường dẫn file SQLite (chỉ dùng khi chạy Node server)
PHSHOP_DB_PATH=./data/phshop.db
# Thư mục file tĩnh khi phục vụ bản build
PHSHOP_STATIC_DIR=./dist

# --- Bảo mật / phiên ---
# Thời hạn phiên đăng nhập (giờ)
PHSHOP_SESSION_TTL_HOURS=48
# Gắn thuộc tính Secure cho cookie (bắt buộc true khi chạy sau HTTPS)
PHSHOP_SECURE_COOKIES=false
# SameSite cookie: Lax (cùng origin) | None (frontend và API khác origin)
PHSHOP_COOKIE_SAMESITE=Lax
# Bật khi server chạy sau reverse proxy (đọc X-Forwarded-For để rate limit theo IP thật)
PHSHOP_TRUST_PROXY=false
# Danh sách origin được phép gọi API chéo origin (CSV), ví dụ: https://phshop.pages.dev
PHSHOP_CORS_ORIGINS=

# --- Tài khoản quản trị ---
# Email mục tiêu của quản trị. Quyền KHÔNG được cấp tự động khi đăng ký.
PHSHOP_ADMIN_EMAIL=nhantk123vip@gmail.com
# Tài khoản được phép thay đổi vai trò người khác (SUPER_ADMIN)
PHSHOP_SUPER_ADMIN_EMAIL=nhantk123vip@gmail.com
# Mật khẩu dùng cho lệnh `npm run bootstrap:admin`.
# Để trống => script tự sinh mật khẩu ngẫu nhiên và in ra MỘT LẦN DUY NHẤT.
PHSHOP_ADMIN_PASSWORD=
# Bắt buộc xác minh email mới được đặt hàng
PHSHOP_REQUIRE_VERIFIED_EMAIL=false

# --- Thanh toán ---
# Bật phương thức MoMo (cần key thật; khi chưa có, API trả 409 thay vì giả lập thành công)
PHSHOP_MOMO_API_KEY=
# Bật phương thức chuyển khoản ngân hàng
PHSHOP_BANK_TRANSFER_API_KEY=

# --- Vận chuyển / khuyến mãi ---
PHSHOP_SHIPPING_FEE=0
PHSHOP_FREE_SHIPPING_THRESHOLD=0

# --- Rate limit (số lần, cửa sổ) ---
PHSHOP_RL_API=600
PHSHOP_RL_LOGIN=10
PHSHOP_RL_REGISTER=5
PHSHOP_RL_RESET=5
PHSHOP_RL_CONTACT=5
PHSHOP_RL_ORDER=20
PHSHOP_RL_REVIEW=10

# --- Giới hạn body (byte) ---
PHSHOP_MAX_BODY=262144

# --- Frontend (build time) ---
# URL của API. Bỏ trống = dùng cùng origin (khi Node server phục vụ cả frontend).
# VITE_API_BASE_URL=https://api.phshop.vn
