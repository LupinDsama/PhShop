{
  "name": "phshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/scripts/seed.js",
    "bootstrap:admin": "node --disable-warning=ExperimentalWarning server/scripts/bootstrap-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.js tests/api/*.test.js",
    "test:unit": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.js",
    "test:api": "node --disable-warning=ExperimentalWarning --test tests/api/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:dev": "node scripts/e2e.mjs --dev"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
